{
  "name": "metrics-ingest-service",
  "version": "0.1.0",
  "private": true,
  "description": "Batch metrics ingestion and exact aggregate queries",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --config jest.config.cjs",
    "test:e2e": "jest --config test/jest-e2e.config.cjs --runInBand",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "ts-node scripts/migrate.ts",
    "db:migrate:test": "ts-node scripts/migrate.ts --test",
    "load": "npm run build && ts-node scripts/load.ts",
    "benchmark": "npm run build && ts-node scripts/benchmark.ts",
    "acceptance": "npm run build && ts-node scripts/acceptance.ts",
    "compare": "ts-node scripts/compare.ts",
    "index:cost": "ts-node scripts/primary-index-cost.ts",
    "index:cost:remaining": "ts-node scripts/remaining-index-cost.ts",
    "index:plans": "ts-node scripts/index-lookup.ts",
    "index:benchmark": "npm run build && ts-node scripts/index-http-benchmark.ts",
    "storage:measure": "npm run build && ts-node scripts/storage.ts",
    "report": "ts-node scripts/report.ts",
    "load:setup": "npm ci && ts-node scripts/setup-load.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:e2e && npm run build"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.0",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.18.0"
  }
}
